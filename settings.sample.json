{
  // iterate-team プラグインを対象リポジトリで使うための権限サンプル。
  //
  // 用途:
  //   対象リポジトリの .claude/settings.json（または settings.local.json）の
  //   "permissions" にマージする。ハーネスが使う補助スクリプト・git read-only
  //   操作・状態書き込みを allow し、直接 push を構造的に塞ぐ。
  //
  // <PLUGIN_ROOT> の解決:
  //   Claude Code の permissions は ${CLAUDE_PLUGIN_ROOT} を展開しないため、下記 <PLUGIN_ROOT>
  //   は実体の絶対パスに置換すること。この値は「ハーネスが実行時に使う ${CLAUDE_PLUGIN_ROOT}」
  //   と一致させる必要がある。marketplace 経由インストールでは Claude Code がプラグインを
  //   ~/.claude/plugins/ 配下（キャッシュ）へコピーし、${CLAUDE_PLUGIN_ROOT} はそのコピー先を
  //   指すため、npm パッケージのパス（npx iterate-team-plugin path）とは一致しない。後者を貼ると
  //   下記 allow ルールが実行時コマンドに一致せず、push ラッパー等がプロンプト化・失敗する。
  //   最も確実な取得方法は、一度セッションを開始した後に SessionStart hook が記録した
  //   init.json の plugin_root を読むこと（marketplace / npm / ローカル clone いずれでも正しい）:
  //       jq -r '.plugin_root' .iterate-team/state/sessions/*/init.json | sort -u
  //   npm / ローカル clone を直接指す構成に限り npx iterate-team-plugin path も使える。
  //
  // 設計意図（push 経路の構造防御）:
  //   push は <PLUGIN_ROOT>/scripts/team-push-branch.sh ラッパー経由のみを無プロンプト
  //   allow する（claude/* 限定 + -f / --force / --mirror / --delete / refspec / refs/ /
  //   特殊 ref(HEAD) / main / master / path traversal を allowlist 拒否）。直接 git push は
  //   主要な破壊的形態を deny し、残りは ask（プロンプト）で人間確認に回す。Claude Code on web
  //   は terminal が無く直接 push の唯一の対話手段が ask のため、全面 deny ではなく ask を採る。
  "permissions": {
    "allow": [
      // (1) MCP（任意）: Codex レビュー / Chrome DevTools UI 検収を使う場合のみ。
      //     未使用なら以下 13 行は削除してよい。
      "mcp__chrome-devtools__navigate_page",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__click",
      "mcp__chrome-devtools__fill",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__list_network_requests",
      "mcp__chrome-devtools__wait_for",
      "mcp__chrome-devtools__new_page",
      "mcp__chrome-devtools__close_page",
      "mcp__chrome-devtools__resize_page",
      "mcp__chrome-devtools__evaluate_script",
      "mcp__codex__codex",

      // (2) ハーネス補助スクリプト（<PLUGIN_ROOT> を実体パスへ置換すること）
      "Bash(<PLUGIN_ROOT>/scripts/runlog-append.sh *)",
      "Bash(<PLUGIN_ROOT>/scripts/runlog-agent-decision.sh *)",
      "Bash(<PLUGIN_ROOT>/scripts/iterate-validate-session.sh *)",
      "Bash(<PLUGIN_ROOT>/scripts/validate-plan.sh *)",
      "Bash(<PLUGIN_ROOT>/scripts/team-compute-waves.sh *)",
      "Bash(<PLUGIN_ROOT>/scripts/team-validate-plan.sh *)",
      "Bash(<PLUGIN_ROOT>/scripts/team-worktree-setup.sh *)",
      "Bash(<PLUGIN_ROOT>/scripts/team-worktree-merge.sh *)",
      "Bash(<PLUGIN_ROOT>/scripts/team-worktree-cleanup.sh *)",
      "Bash(<PLUGIN_ROOT>/scripts/team-push-branch.sh *)",
      "Bash(<PLUGIN_ROOT>/scripts/knowledge-append.sh *)",
      "Bash(<PLUGIN_ROOT>/scripts/knowledge-digest.sh *)",
      "Bash(<PLUGIN_ROOT>/scripts/knowledge-prune.sh *)",

      // (3) git read-only / ブランチ操作系
      "Bash(git worktree list*)",
      "Bash(git symbolic-ref --short HEAD)",
      "Bash(git remote get-url origin)",
      "Bash(git rev-parse HEAD)",
      "Bash(git rev-parse --show-toplevel)",
      "Bash(git rev-parse --verify *)",
      "Bash(git rev-parse --verify \"*)",
      "Bash(git fetch origin main)",
      "Bash(git status --porcelain*)",
      "Bash(git switch -c claude/*)",
      "Bash(git switch -c \"claude/*)",
      "Bash(git branch -m claude/*)",
      "Bash(git branch -m \"claude/*)",
      "Bash(git log -1 --format=*)",
      "Bash(git log --grep=Refs:*)",
      "Bash(git log --grep=\"Refs:*)",
      "Bash(git restore --staged --worktree -- .iterate-team/knowledge/)",
      "Bash(git restore --staged --worktree -- .iterate-team/knowledge/*)",

      // (4) ハーネス状態の書き込み（対象リポ直下 .iterate-team/state/ 配下）
      "Write(.iterate-team/state/*/**)",
      "Edit(.iterate-team/state/*/**)",
      // 6.7 fail-open の退避用（レトロスペクティブ失敗時に untracked な knowledge 生成物を
      // .iterate-team/state/<session-id>/failed-retrospective/ へ退避する）
      "Bash(mkdir -p .iterate-team/state/*)",
      "Bash(mv .iterate-team/knowledge/* .iterate-team/state/*)",

      // (5) knowledge（クロスセッション自己学習、git-tracked。knowledge-policy.md 参照）の書き込み
      "Write(.iterate-team/knowledge/**)",
      "Edit(.iterate-team/knowledge/**)"
    ],
    "deny": [
      // push 経路の防御: 直接 git push の主要な破壊的形態を deny する。
      // force / --force（exact + 位置不問）/ --force-with-lease / --force-if-includes /
      // --mirror / --delete / -d / +refspec（先頭 + の force 更新）を遮断する。
      // ※ 短縮結合フラグ（git push -uf 等）は glob 列挙では branch 名衝突なしに
      //   塞げない（-*f* は git push -u origin feature 等の正規 push も誤遮断する）。
      //   このため直接 git push 全般は末尾 ask で人間確認に回す（Claude Code on web は
      //   terminal が無く、ask が直接 push の唯一の対話手段）。構造防御の本体は
      //   claude/* 限定の team-push-branch.sh ラッパー（唯一の無プロンプト push 経路）。
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git push -f)",
      "Bash(git push --force)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push --force-if-includes*)",
      "Bash(git push * --force-if-includes*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push * -d)",
      // 一括 add / 破壊的 reset の禁止（ハーネスは個別 add のみ）。
      "Bash(git add .)",
      "Bash(git add -A)",
      "Bash(git reset --hard *)",
      // 一般的な安全策（任意）。
      "Bash(npm publish *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ],
    "ask": ["Bash(git push *)", "Bash(git push)"]
  }
}
